# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Database (Drizzle ORM) ────────────────────────────────────────────────────
# Obtén la connection string en: Supabase > Settings > Database > Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Visual Art AI

# ─── Payments ─────────────────────────────────────────────────────────────────
# Selecciona el proveedor activo: "transbank" o "mercadopago"
PAYMENT_PROVIDER=transbank

# Transbank Webpay Plus (Integration/Sandbox)
# Credenciales de integración oficiales (NO usar en producción)
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENVIRONMENT=integration

# MercadoPago (Sandbox)
# Obtén en: developers.mercadopago.com > Tus integraciones
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
