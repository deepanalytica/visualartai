      "html": "<label class=\"ds-field\"><span>¿Dónde te contactamos?</span><input type=\"email\" autocomplete=\"email\" placeholder=\"tu@email.cl\"></label>",
      "css": ".ds-field{display:grid;gap:.5rem;max-width:24rem;font-family:var(--font-sans,Manrope,Arial,sans-serif)}.ds-field>span{font-size:.75rem;font-weight:750}.ds-field input{width:100%;min-height:3.25rem;padding:.8125rem .875rem;border:1px solid var(--input-border,#cbd5e1);border-radius:var(--radius-md,.875rem);background:var(--input-bg,#fff);color:var(--color-text-primary,#08111f);font:400 1rem var(--font-sans,Manrope,Arial,sans-serif);transition:border-color 180ms,box-shadow 180ms}.ds-field input:focus{border-color:var(--color-action-primary,#2f6bff);outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--color-focus,#9fbcff) 38%,transparent)}"
