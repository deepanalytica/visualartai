      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:3.25rem;padding:0 1.25rem;border:1px solid transparent;border-radius:var(--control-radius,.875rem);font:750 .875rem var(--font-sans,Manrope,Arial,sans-serif);cursor:pointer;transition:transform var(--duration-fast,180ms) var(--ease-standard,cubic-bezier(.2,.8,.2,1)),background 180ms,border-color 180ms;background:var(--button-primary-bg,#2f6bff);color:var(--button-primary-text,#fff);box-shadow:var(--shadow-brand,0 18px 50px rgba(47,107,255,.18))}.ds-primary:hover{background:var(--button-primary-bg-hover,#2454d8);transform:translateY(-2px)}.ds-primary:active{background:var(--color-action-primary-pressed,#1e45ad);transform:translateY(0)}.ds-primary:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--color-focus,#9fbcff) 38%,transparent)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
