      "css": ".ds-whatsapp{display:inline-flex;align-items:center;justify-content:center;min-height:3.25rem;padding:0 1.25rem;border:1px solid transparent;border-radius:var(--control-radius,.875rem);font:750 .875rem var(--font-sans,Manrope,Arial,sans-serif);cursor:pointer;transition:transform var(--duration-fast,180ms) var(--ease-standard,cubic-bezier(.2,.8,.2,1)),background 180ms,border-color 180ms;min-height:2.75rem;background:var(--color-success-strong,#15775d);border-color:var(--color-success-strong,#15775d);color:#fff;letter-spacing:0;text-transform:none}.ds-whatsapp:hover{background:#105c48;border-color:#105c48;transform:translateY(-2px)}.ds-whatsapp:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--color-focus,#9fbcff) 38%,transparent)}"
