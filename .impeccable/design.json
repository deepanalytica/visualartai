      "name": "Desktop Navigation",
      "kind": "nav",
      "description": "Sans links with quiet blue hover treatment.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Principal\"><a href=\"#problema\">Problemas</a><a href=\"#recorrido\">Servicios</a><a href=\"#precios\">Precios</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:.125rem}.ds-nav a{padding:.625rem .75rem;border-radius:999px;font:700 .875rem var(--font-sans,Manrope,Arial,sans-serif);color:var(--color-text-secondary,#334155);text-decoration:none;transition:color 180ms,background 180ms}.ds-nav a:hover{color:var(--color-action-primary-hover,#2454d8);background:var(--color-action-soft,#f2f6ff)}.ds-nav a:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--color-focus,#9fbcff) 38%,transparent)}"
